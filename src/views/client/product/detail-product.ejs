<%- include("../layout/header", { currentPage: "detail" }) %>

<main class="product-detail-page">
    <div class="container">
        <nav class="detail-breadcrumb" aria-label="Điều hướng">
            <a href="/">Trang chủ</a><i class="fas fa-chevron-right"></i>
            <a href="/#products">Sản phẩm</a><i class="fas fa-chevron-right"></i>
            <span><%= product.name || 'Chi tiết sản phẩm' %></span>
        </nav>

        <section class="detail-card">
            <div class="row g-5 align-items-center">
                <div class="col-lg-6">
                    <div class="detail-image-wrap">
                        <% if (product.image) { %>
                            <img src="/images/image-product/<%= product.image %>" alt="<%= product.name || 'Laptop' %>" class="detail-image">
                        <% } else { %>
                            <span class="detail-image-placeholder"><i class="fas fa-laptop"></i></span>
                        <% } %>
                        <% if (product.factory) { %><span class="detail-brand"><%= product.factory %></span><% } %>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="detail-info">
                        <span class="detail-eyebrow"><i class="fas fa-laptop me-2"></i>Laptop chính hãng</span>
                        <h1><%= product.name || 'Sản phẩm chưa có tên' %></h1>
                        <div class="detail-rating" aria-label="Đánh giá 5 sao">
                            <% for (let i = 0; i < 5; i++) { %><i class="fas fa-star"></i><% } %>
                            <span>Sản phẩm chất lượng</span>
                        </div>
                        <div class="detail-price"><%= new Intl.NumberFormat('vi-VN').format(product.price) %> ₫</div>
                        <p class="detail-summary"><%= product.shortDesc || 'Thông tin sản phẩm đang được cập nhật.' %></p>

                        <dl class="detail-specs">
                            <div><dt>Thương hiệu</dt><dd><%= product.factory || 'Đang cập nhật' %></dd></div>
                            <div><dt>Phù hợp</dt><dd><%= product.target || 'Mọi nhu cầu' %></dd></div>
                            <div><dt>Tình trạng</dt><dd class="<%= product.quantity > 0 ? 'in-stock' : 'out-of-stock' %>"><%= product.quantity > 0 ? `Còn hàng (${product.quantity})` : 'Tạm hết hàng' %></dd></div>
                            <div><dt>Đã bán</dt><dd><%= product.sold || 0 %> sản phẩm</dd></div>
                        </dl>

                        <div class="detail-purchase">
                            <div class="quantity detail-quantity" aria-label="Số lượng">
                                <button type="button" class="btn-minus" aria-label="Giảm số lượng"><i class="fas fa-minus"></i></button>
                                <input id="detail-quantity" type="number" value="1" min="1" max="<%= Math.max(product.quantity, 1) %>" readonly>
                                <button type="button" class="btn-plus" aria-label="Tăng số lượng"><i class="fas fa-plus"></i></button>
                            </div>
                            <button type="button" class="detail-add-cart" data-add-to-cart data-product-id="<%= product.id %>" data-quantity-input="#detail-quantity" <%= product.quantity <= 0 ? 'disabled' : '' %>>
                                <i class="fas fa-shopping-bag"></i><%= product.quantity > 0 ? 'Thêm vào giỏ hàng' : 'Tạm hết hàng' %>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="detail-description">
            <div class="detail-section-title"><span>Thông tin chi tiết</span><h2>Mô tả sản phẩm</h2></div>
            <p><%= product.detailDesc || product.shortDesc || 'Thông tin chi tiết của sản phẩm đang được cập nhật.' %></p>
        </section>

        <% if (relatedProducts.length > 0) { %>
            <section class="related-products">
                <div class="section-heading d-flex flex-wrap align-items-end justify-content-between gap-3">
                    <div><span class="detail-section-label">Có thể bạn quan tâm</span><h2>Laptop cùng thương hiệu</h2></div>
                    <a href="/#products" class="view-all-products">Xem tất cả <i class="fas fa-arrow-right"></i></a>
                </div>
                <div class="row g-4">
                    <% relatedProducts.forEach((item) => { %>
                        <div class="col-sm-6 col-lg-3">
                            <article class="product-card">
                                <a href="/product/<%= item.id %>" class="product-image">
                                    <% if (item.image) { %><img src="/images/image-product/<%= item.image %>" alt="<%= item.name || 'Laptop' %>">
                                    <% } else { %><span class="product-image-placeholder"><i class="fas fa-laptop"></i></span><% } %>
                                </a>
                                <div class="product-body">
                                    <h4><a href="/product/<%= item.id %>"><%= item.name || 'Sản phẩm chưa có tên' %></a></h4>
                                    <p><%= item.shortDesc || 'Đang cập nhật thông tin sản phẩm.' %></p>
                                    <div class="product-meta"><strong><%= new Intl.NumberFormat('vi-VN').format(item.price) %> ₫</strong></div>
                                </div>
                            </article>
                        </div>
                    <% }); %>
                </div>
            </section>
        <% } %>
    </div>
</main>

<%- include("../layout/footer") %>
