<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <title>Laptopshop - Sản phẩm chính hãng</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta name="description" content="Laptopshop - sản phẩm chất lượng, dịch vụ tận tâm">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Open+Sans:wght@400;500;600&family=Raleway:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/client/css/bootstrap.min.css" rel="stylesheet">
    <link href="/client/css/style.css" rel="stylesheet">
</head>
<body>
    <div id="spinner" class="show w-100 vh-100 bg-white position-fixed translate-middle top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-grow text-primary" role="status"><span class="visually-hidden">Đang tải...</span></div>
    </div>
    <header class="site-header fixed-top">
        <div class="container topbar bg-primary d-none d-lg-flex justify-content-between align-items-center">
            <div class="top-info">
                <small class="me-4"><i class="fas fa-map-marker-alt me-2 text-secondary"></i>123 Hà Nội, Việt Nam</small>
                <small><i class="fas fa-envelope me-2 text-secondary"></i><a href="mailto:admin@hoidanit.vn">admin@hoidanit.vn</a></small>
            </div>
            <div class="top-link"><a href="#">Điều khoản sử dụng</a><span class="mx-2">/</span><a href="#">Hỏi đáp</a></div>
        </div>
        <div class="nav-shell bg-white shadow-sm">
            <div class="container px-0">
                <nav class="navbar navbar-light navbar-expand-lg">
                    <a href="/" class="navbar-brand"><h1 class="text-primary mb-0">Laptopshop</h1></a>
                    <button class="navbar-toggler py-2 px-3" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-label="Mở menu"><span class="fa fa-bars text-primary"></span></button>
                    <div class="collapse navbar-collapse bg-white" id="navbarCollapse">
                        <div class="navbar-nav mx-auto">
                            <a href="/" class="nav-item nav-link <%= currentPage === 'home' ? 'active' : '' %>">Trang chủ</a>
                            <a href="<%= currentPage === 'home' ? '#products' : '/#products' %>" class="nav-item nav-link <%= currentPage === 'detail' ? 'active' : '' %>">Sản phẩm</a>
                        </div>
                        <div class="header-actions d-flex align-items-center">
                            <a href="#" class="position-relative me-4" aria-label="Giỏ hàng"><i class="fas fa-shopping-bag fa-2x"></i><span class="cart-count" data-cart-count>0</span></a>
                            <a href="#" aria-label="Tài khoản"><i class="fas fa-user fa-2x"></i></a>
                        </div>
                    </div>
                </nav>
            </div>
        </div>
    </header>
