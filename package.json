{
  "name": "web-practice",
  "version": "1.0.0",
  "description": "web-practice",
  "main": "src/app.ts",
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/app.js",
    "dev": "nodemon",
    "seed": "ts-node -r tsconfig-paths/register src/config/seed.ts",
    "start:debug": "nodemon --inspect=9229 -e ts,tsx --exec node -r ts-node/register -r tsconfig-paths/register ./src/app.ts"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register src/config/seed.ts"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "ignore": [
      "node_modules"
    ],
    "exec": "ts-node -r tsconfig-paths/register ./src/app.ts"
  },
  "keywords": [],
  "author": "me",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DuxngLee/web-practice.git"
  },
  "bugs": {
    "url": "https://github.com/DuxngLee/web-practice/issues"
  },
  "homepage": "https://github.com/DuxngLee/web-practice#readme",
  "dependencies": {
    "@prisma/client": "6.3.0",
    "bcrypt": "5.1.1",
    "dotenv": "16.4.7",
    "ejs": "3.1.10",
    "express": "5.0.1",
    "multer": "1.4.5-lts.1",
    "mysql2": "3.12.0",
    "uuid": "11.0.5"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.0",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.7",
    "nodemon": "3.1.9",
    "prisma": "6.3.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.3"
  }
}
