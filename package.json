{
  "name": "web-practice",
  "version": "1.0.0",
  "description": "web-practice",
  "main": "src/app.ts",
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/app.js",
    "dev": "nodemon"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "ignore": [
      "node_modules"
    ],
    "exec": "ts-node ./src/app.ts"
  },
  "keywords": [],
  "author": "me",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DuxngLee/web-practice.git"
  },
  "bugs": {
    "url": "https://github.com/DuxngLee/web-practice/issues"
  },
  "homepage": "https://github.com/DuxngLee/web-practice#readme",
  "dependencies": {
    "dotenv": "16.4.7",
    "ejs": "3.1.10",
    "express": "5.0.1",
    "mysql2": "3.12.0"
  },
  "devDependencies": {
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.0",
    "@types/node": "22.10.7",
    "nodemon": "3.1.9",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  }
}
